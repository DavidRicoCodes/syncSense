{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sync:schema:v1:association-request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "association_id", "run_id", "adapter", "maximum_delta_ms", "session_manifest_path", "session_manifest_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "association_id": {"type": "string", "pattern": "^assoc_[0-9]{8}T[0-9]{12}Z_[0-9a-f]{12}$"},
    "run_id": {"type": "string", "minLength": 1},
    "adapter": {"const": "nearest-ntp"},
    "maximum_delta_ms": {"type": "number", "exclusiveMinimum": 0},
    "session_manifest_path": {"const": "manifest.json"},
    "session_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
