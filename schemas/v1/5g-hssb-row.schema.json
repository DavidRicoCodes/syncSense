{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sync:schema:v1:5g-hssb-row",
  "title": "FiveGHssbRowV1",
  "type": "object",
  "required": [
    "schema", "protocol_version", "waveform_type", "profile_id", "iteration",
    "valid", "error", "clock_domain", "block_start_device_ticks",
    "detector_offset_samples", "event_device_ticks", "device_tick_rate_hz",
    "reference_point", "canonical_timestamp_semantics", "event_monotonic_ns",
    "event_unix_ns", "timestamp_unix", "timestamp_utc", "timestamp_semantics",
    "clock_anchor_schema", "clock_anchor_uncertainty_ns",
    "capture_call_started_monotonic_ns", "capture_finished_monotonic_ns",
    "capture_finished_unix_ns", "center_frequency_hz", "sample_rate_hz",
    "cfo_hz", "usrp", "feature_name", "feature_dtype", "feature_shape",
    "feature_flatten_order", "feature_count", "feature_storage", "raw_rxgrid",
    "hssb_binary", "numeric_metadata"
  ],
  "properties": {
    "schema": {"const": "joint_5g_hssb_jsonl_v1"},
    "protocol_version": {"const": 1},
    "waveform_type": {"const": "5g_ssb"},
    "profile_id": {"const": "n78_ssb_30khz"},
    "iteration": {"type": "integer", "minimum": 0},
    "valid": {"const": true},
    "error": {"const": ""},
    "clock_domain": {"const": "local_device_epoch"},
    "block_start_device_ticks": {"type": "integer", "minimum": 0},
    "detector_offset_samples": {"type": "integer", "minimum": 0},
    "event_device_ticks": {"type": "integer", "minimum": 0},
    "device_tick_rate_hz": {"type": "integer", "minimum": 1},
    "reference_point": {"const": "ssb_pss_start"},
    "canonical_timestamp_semantics": {"const": "local_usrp_device_time_first_sample_plus_detector_offset_samples"},
    "event_monotonic_ns": {"type": "integer", "minimum": 0},
    "event_unix_ns": {"type": "integer", "minimum": 0},
    "timestamp_unix": {"type": "number"},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "timestamp_semantics": {"const": "host_operational_estimate_only_from_block_end_and_detector_offset; cross_host_use_requires_ntp_anchors_and_is_not_acquisition_alignment"},
    "clock_anchor_schema": {"const": "rx_host_clock_anchor_v1"},
    "clock_anchor_uncertainty_ns": {"type": "integer", "minimum": 0},
    "capture_call_started_monotonic_ns": {"type": "integer", "minimum": 0},
    "capture_finished_monotonic_ns": {"type": "integer", "minimum": 0},
    "capture_finished_unix_ns": {"type": "integer", "minimum": 0},
    "center_frequency_hz": {"type": "number"},
    "sample_rate_hz": {"type": "number", "exclusiveMinimum": 0},
    "cfo_hz": {"type": "number"},
    "usrp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "gain_db"],
      "properties": {
        "channel": {"type": "integer", "minimum": 0},
        "gain_db": {"type": "number"}
      }
    },
    "feature_name": {"const": "hSSB"},
    "feature_dtype": {"const": "complex64"},
    "feature_shape": {"const": [240, 4]},
    "feature_flatten_order": {"const": "C"},
    "feature_count": {"const": 960},
    "feature_storage": {"const": "hssb_binary"},
    "raw_rxgrid": {"$ref": "#/$defs/binary_ref"},
    "hssb_binary": {"$ref": "#/$defs/binary_ref"},
    "numeric_metadata": {"type": "object"}
  },
  "$defs": {
    "binary_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "path_semantics", "byte_offset", "dtype", "shape", "flatten_order"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "path_semantics": {"const": "relative_to_jsonl_directory"},
        "byte_offset": {"type": "integer", "minimum": 0},
        "dtype": {"const": "complex64"},
        "shape": {"const": [240, 4]},
        "flatten_order": {"const": "C"}
      }
    }
  },
  "additionalProperties": false
}
