{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sync:schema:v1:wifi-bf-like-feature-row",
  "title": "WifiHeNdpLikeFeatureRowV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version", "waveform_type", "profile_id", "transmitter_id",
    "experiment_id", "schema", "waveform_type_name", "profile_name",
    "session_id", "receiver_group_id", "tx_timestamp_ns",
    "scheduled_tx_time_ns", "feature_name", "feature_dtype",
    "feature_shape", "feature_flatten_order", "feature_count", "valid",
    "error", "packet_counter", "sample_offset", "has_rx_device_time",
    "rx_block_start_ticks", "rx_timestamp_ticks", "rx_tick_rate_hz",
    "rx_timestamp_ns", "sample_rate_hz", "center_frequency_hz", "snr_db",
    "cfo_hz", "power_dbfs", "numeric_metadata", "text_metadata",
    "complex_features", "real_features", "payload"
  ],
  "properties": {
    "protocol_version": {"const": 1},
    "waveform_type": {"const": 2},
    "profile_id": {"const": 3},
    "transmitter_id": {"const": 1},
    "experiment_id": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "schema": {"const": "alb_he_ndp_like_sounding_v1"},
    "waveform_type_name": {"const": "he_ndp_like"},
    "profile_name": {"const": "alb_he_ndp_like_siso_40mhz_v1"},
    "session_id": {"const": 1},
    "receiver_group_id": {"const": 0},
    "tx_timestamp_ns": {"type": "integer", "minimum": 0},
    "scheduled_tx_time_ns": {"type": "integer", "minimum": 0},
    "feature_name": {"const": "he_ltf_csi"},
    "feature_dtype": {"const": "complex64"},
    "feature_shape": {"const": [8, 242]},
    "feature_flatten_order": {"const": "C"},
    "feature_count": {"const": 1936},
    "valid": {"const": true},
    "error": {"const": ""},
    "packet_counter": {"type": "integer", "minimum": 0},
    "sample_offset": {"type": "integer", "minimum": 0},
    "has_rx_device_time": {"const": true},
    "rx_block_start_ticks": {"type": "integer", "minimum": 0},
    "rx_timestamp_ticks": {"type": "integer", "minimum": 0},
    "rx_tick_rate_hz": {"type": "integer", "minimum": 1},
    "rx_timestamp_ns": {"type": "integer", "minimum": 0},
    "sample_rate_hz": {"type": "number", "exclusiveMinimum": 0},
    "center_frequency_hz": {"type": "number", "exclusiveMinimum": 0},
    "snr_db": {"type": "number"},
    "cfo_hz": {"type": "number"},
    "power_dbfs": {"type": "number"},
    "numeric_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "num_he_ltf", "he_ltf_tones", "alb_control_bytes",
        "alb_codeword_repetitions", "packet_duration_samples", "fcs_valid",
        "coarse_cfo_hz", "fine_cfo_hz", "preamble_metric",
        "lltf_timing_metric", "he_ltf_repetition_metric"
      ],
      "properties": {
        "num_he_ltf": {"type": "number"},
        "he_ltf_tones": {"type": "number"},
        "alb_control_bytes": {"type": "number"},
        "alb_codeword_repetitions": {"type": "number"},
        "packet_duration_samples": {"type": "number"},
        "fcs_valid": {"type": "number"},
        "coarse_cfo_hz": {"type": "number"},
        "fine_cfo_hz": {"type": "number"},
        "preamble_metric": {"type": "number"},
        "lltf_timing_metric": {"type": "number"},
        "he_ltf_repetition_metric": {"type": "number"}
      }
    },
    "text_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["magic", "training_family"],
      "properties": {
        "magic": {"const": "ALBF"},
        "training_family": {"const": "he_ltf_2x_40mhz"}
      }
    },
    "complex_features": {
      "type": "array",
      "minItems": 1936,
      "maxItems": 1936,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["real", "imag"],
        "properties": {
          "real": {"type": "number"},
          "imag": {"type": "number"}
        }
      }
    },
    "real_features": {"type": "array", "maxItems": 0},
    "payload": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": {"type": "integer", "minimum": 0, "maximum": 255}
    }
  }
}
