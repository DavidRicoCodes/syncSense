{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sync:schema:v1:wifi-bf-like-feature-row",
  "title": "WifiBfLikeFeatureRowV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version", "waveform_type", "profile_id", "transmitter_id",
    "experiment_id", "schema", "waveform_type_name", "profile_name",
    "session_id", "receiver_group_id", "tx_timestamp_ns",
    "scheduled_tx_time_ns", "feature_name", "feature_dtype",
    "feature_shape", "feature_flatten_order", "feature_count", "valid",
    "error", "packet_counter", "sample_offset", "has_rx_device_time",
    "rx_block_start_ticks", "rx_timestamp_ticks", "rx_tick_rate_hz",
    "rx_timestamp_ns", "sample_rate_hz", "center_frequency_hz", "snr_db",
    "cfo_hz", "power_dbfs", "numeric_metadata", "text_metadata",
    "complex_features", "real_features", "payload"
  ],
  "properties": {
    "protocol_version": {"type": "integer", "minimum": 0},
    "waveform_type": {"type": "integer", "minimum": 0},
    "profile_id": {"const": 2},
    "transmitter_id": {"type": "integer", "minimum": 0},
    "experiment_id": {"type": "integer", "minimum": 1, "maximum": 65535},
    "schema": {"const": "alb_bf_like_golay52_sounding_v2"},
    "waveform_type_name": {"const": "bf_like"},
    "profile_name": {"const": "alb_bf_like_golay52_siso_20mhz_v2"},
    "session_id": {"type": "integer", "minimum": 0},
    "receiver_group_id": {"type": "integer", "minimum": 0},
    "tx_timestamp_ns": {"type": "integer", "minimum": 0},
    "scheduled_tx_time_ns": {"type": "integer", "minimum": 0},
    "feature_name": {"const": "bf_ltf_csi"},
    "feature_dtype": {"const": "complex64"},
    "feature_shape": {"const": [8, 52]},
    "feature_flatten_order": {"const": "C"},
    "feature_count": {"const": 416},
    "valid": {"const": true},
    "error": {"const": ""},
    "packet_counter": {"type": "integer", "minimum": 0},
    "sample_offset": {"type": "integer", "minimum": 0},
    "has_rx_device_time": {"const": true},
    "rx_block_start_ticks": {"type": "integer", "minimum": 0},
    "rx_timestamp_ticks": {"type": "integer", "minimum": 0},
    "rx_tick_rate_hz": {"type": "integer", "minimum": 1},
    "rx_timestamp_ns": {"type": "integer", "minimum": 0},
    "sample_rate_hz": {"type": "number", "exclusiveMinimum": 0},
    "center_frequency_hz": {"type": "number", "exclusiveMinimum": 0},
    "snr_db": {"type": "number"},
    "cfo_hz": {"type": "number"},
    "power_dbfs": {"type": "number"},
    "numeric_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "burst_id", "sounding_index", "beam_id", "codebook_id",
        "antenna_mask", "num_tx_antennas", "num_rx_antennas_expected",
        "num_spatial_streams", "num_bf_ltf", "training_sequence_id",
        "training_seed", "bandwidth_hz", "tx_gain_db", "tx_channel",
        "tx_antenna_id", "frame_period_us", "packet_duration_samples",
        "header_crc_valid", "frame_fcs_valid", "stf_metric",
        "preamble_metric", "coarse_cfo_hz", "fine_cfo_hz",
        "bf_ltf_signal_power", "bf_ltf_noise_power",
        "bf_ltf_common_phase_aligned", "golay_pair_length",
        "golay_pair_repetitions"
      ],
      "properties": {
        "burst_id": {"type": "number"},
        "sounding_index": {"type": "number"},
        "beam_id": {"type": "number"},
        "codebook_id": {"type": "number"},
        "antenna_mask": {"type": "number"},
        "num_tx_antennas": {"type": "number"},
        "num_rx_antennas_expected": {"type": "number"},
        "num_spatial_streams": {"type": "number"},
        "num_bf_ltf": {"type": "number"},
        "training_sequence_id": {"type": "number"},
        "training_seed": {"type": "number"},
        "bandwidth_hz": {"type": "number"},
        "tx_gain_db": {"type": "number"},
        "tx_channel": {"type": "number"},
        "tx_antenna_id": {"type": "number"},
        "frame_period_us": {"type": "number"},
        "packet_duration_samples": {"type": "number"},
        "header_crc_valid": {"type": "number"},
        "frame_fcs_valid": {"type": "number"},
        "stf_metric": {"type": "number"},
        "preamble_metric": {"type": "number"},
        "coarse_cfo_hz": {"type": "number"},
        "fine_cfo_hz": {"type": "number"},
        "bf_ltf_signal_power": {"type": "number"},
        "bf_ltf_noise_power": {"type": "number"},
        "bf_ltf_common_phase_aligned": {"type": "number"},
        "golay_pair_length": {"type": "number"},
        "golay_pair_repetitions": {"type": "number"}
      }
    },
    "text_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["magic", "bf_sig_magic", "training_family"],
      "properties": {
        "magic": {"const": "ALBBFLK1"},
        "bf_sig_magic": {"const": "ABFS"},
        "training_family": {"const": "golay_complementary_52_subcarrier"}
      }
    },
    "complex_features": {
      "type": "array",
      "minItems": 416,
      "maxItems": 416,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["real", "imag"],
        "properties": {"real": {"type": "number"}, "imag": {"type": "number"}}
      }
    },
    "real_features": {"type": "array", "maxItems": 0},
    "payload": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 255}}
  }
}
