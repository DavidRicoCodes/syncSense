{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sync:schema:v1:host-clock-anchor",
  "title": "HostClockAnchorV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase", "monotonic_ns", "realtime_ns", "sampling_uncertainty_ns", "semantics"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "phase": {"enum": ["start", "end"]},
    "monotonic_ns": {"type": "integer", "minimum": 0},
    "realtime_ns": {"type": "integer", "minimum": 0},
    "sampling_uncertainty_ns": {"type": "integer", "minimum": 0},
    "semantics": {"const": "operational_host_clock_anchor_not_acquisition_time"}
  }
}
